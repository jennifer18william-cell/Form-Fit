# 1. Supabase Project URL & Public Key (Supabase Dashboard -> Project Settings -> API / Data API)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# 2. Supabase Server Secret Key (Supabase Dashboard -> Project Settings -> API Keys -> service_role / secret key)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"

# 3. Store Owner Admin Login Credentials
ADMIN_EMAIL="admin@patanakart.in"
ADMIN_PASSCODE="YOUR_ADMIN_PASSCODE"

# 4. Server-Side Gemini AI Key (Required for AI Fashion Stylist & Visual Product Search - keep server-side only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 5. Optional Visual Match Threshold Tuning (0-100 scale)
STYLIST_EXACT_MATCH_THRESHOLD="82"
STYLIST_STRONG_MATCH_THRESHOLD="58"
STYLIST_INITIAL_MATCH_LIMIT="6"

# 6. Customer Email Notifications (Choose SMTP e.g. Gmail App Password OR Resend API - server-side only)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="YOUR_SMTP_EMAIL_ADDRESS"
SMTP_PASS="YOUR_SMTP_APP_PASSWORD"
SMTP_FROM="PatanaKart <notifications@patanakart.in>"
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# 7. Customer Mobile SMS Notifications (Choose Twilio OR Fast2SMS for India - server-side only)
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_FROM_NUMBER="+1234567890"
FAST2SMS_API_KEY="YOUR_FAST2SMS_API_KEY"


